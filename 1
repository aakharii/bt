pragma solidity ^0.8.21;
 
contract Product {
    uint256 public productId;
    string public productName;
    uint256 public price;
    uint256 public stock;
 
    constructor(uint256 id, string memory name, uint256 productPrice, uint256 productStock) {
        productId = id;
        productName = name;
        price = productPrice;
        stock = productStock;
    }
 
    function displayProduct() public view returns (uint256, string memory, uint256, uint256) {
        return (productId, productName, price, stock);
    }
}
 
contract OnlineStore is Product {
    address public owner;
    mapping(address => uint256) public purchases;
 
    constructor(uint256 id, string memory name, uint256 productPrice, uint256 productStock)
        Product(id, name, productPrice, productStock) {
        owner = msg.sender;
    }
 
    function buy(uint256 quantity) public payable {
        require(quantity > 0 && quantity <= stock, "Invalid quantity");
        require(msg.value == price * quantity, "Incorrect payment");
        stock -= quantity;
        purchases[msg.sender] += quantity;
    }
 
    function withdrawPayments() public {
        require(msg.sender == owner, "Only owner");
        payable(owner).transfer(address(this).balance);
    }
}
