// SPDX-License-Identifier: MIT
pragma solidity ^0.8.21;
 
contract StudentScholarship {
    struct Student {
        uint256 studentId;
        string studentName;
        string studentCourse;
        uint256 studentMarks;
        bool scholarshipEligibility;
    }
 
    mapping(uint256 => Student) public students;
    mapping(uint256 => bool) public isRegistered;
    mapping(uint256 => bool) public hasClaimed;
    address public owner;
    uint256 public scholarshipAmount = 4 wei;
 
    constructor() { owner = msg.sender; }
 
    modifier onlyOwner() {
        require(msg.sender == owner, "Only owner");
        _;
    }
 
    function addStudent(
        uint256 studentId, string memory studentName,
        string memory studentCourse, uint256 studentMarks
    ) public onlyOwner {
        require(!isRegistered[studentId], "Student ID already exists");
        students[studentId] = Student(
            studentId, studentName, studentCourse,
            studentMarks, studentMarks >= 60
        );
        isRegistered[studentId] = true;
    }
 
    function getStudent(uint256 studentId)
        public view returns (uint256, string memory, string memory, uint256, bool)
    {
        require(isRegistered[studentId], "Student record not found");
        Student memory s = students[studentId];
        return (s.studentId, s.studentName, s.studentCourse, s.studentMarks, s.scholarshipEligibility);
    }
 
    function depositFunds() public payable onlyOwner {}
 
    function claimScholarship(uint256 studentId) public {
        require(isRegistered[studentId], "Student record not found");
        require(students[studentId].scholarshipEligibility, "Student not eligible");
        require(!hasClaimed[studentId], "Scholarship already claimed");
        require(address(this).balance >= scholarshipAmount, "Insufficient funds");
        hasClaimed[studentId] = true;
        payable(msg.sender).transfer(scholarshipAmount);
    }
 
    function getTotalFunds() public view returns (uint256) {
        return address(this).balance;
    }
}
