'use strict';
 
const { Contract } = require('fabric-contract-api');
 
class StudentContract extends Contract {
  async createStudent(ctx, id, name, course, marks) {
    const key = `STUDENT_${id}`;
    const exists = await ctx.stub.getState(key);
    if (exists && exists.length > 0) {
      throw new Error(`Student ${id} already exists`);
    }
    const student = { id, name, course, marks: Number(marks) };
    await ctx.stub.putState(key, Buffer.from(JSON.stringify(student)));
    return JSON.stringify(student);
  }
 
  async readStudent(ctx, id) {
    const key = `STUDENT_${id}`;
    const data = await ctx.stub.getState(key);
    if (!data || data.length === 0) {
      throw new Error(`Student ${id} does not exist`);
    }
    return data.toString();
  }
 
  async updateStudent(ctx, id, name, course, marks) {
    const key = `STUDENT_${id}`;
    const data = await ctx.stub.getState(key);
    if (!data || data.length === 0) {
      throw new Error(`Student ${id} does not exist`);
    }
    const student = { id, name, course, marks: Number(marks) };
    await ctx.stub.putState(key, Buffer.from(JSON.stringify(student)));
    return JSON.stringify(student);
  }
 
  async deleteStudent(ctx, id) {
    const key = `STUDENT_${id}`;
    const data = await ctx.stub.getState(key);
    if (!data || data.length === 0) {
      throw new Error(`Student ${id} does not exist`);
    }
    await ctx.stub.deleteState(key);
    return `Student ${id} deleted`;
  }
}
 
