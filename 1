pragma solidity ^0.8.21;
 
contract VehicleRental {
    struct Vehicle {
        string name;
        uint256 dailyRate;
        bool available;
    }
 
    mapping(uint256 => Vehicle) public vehicles;
    mapping(address => uint256) public rentalVehicle;
    uint256 public nextVehicleId = 1;
 
    function addVehicle(string memory name, uint256 dailyRate) public {
        require(dailyRate > 0, "Rate must be positive");
        vehicles[nextVehicleId] = Vehicle(name, dailyRate, true);
        nextVehicleId++;
    }
 
    function rentVehicle(uint256 vehicleId, uint256 daysToRent) public payable {
        Vehicle storage v = vehicles[vehicleId];
        require(v.available, "Vehicle unavailable");
        require(daysToRent > 0, "Invalid rental duration");
        require(msg.value == v.dailyRate * daysToRent, "Incorrect rental payment");
        v.available = false;
        rentalVehicle[msg.sender] = vehicleId;
    }
 
    function returnVehicle(uint256 vehicleId) public {
        require(rentalVehicle[msg.sender] == vehicleId, "Not your rental");
        vehicles[vehicleId].available = true;
        delete rentalVehicle[msg.sender];
    }
}
