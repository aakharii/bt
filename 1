pragma solidity ^0.8.21;
 
contract PrimeCheck {
    function isPrime(uint256 number) public pure returns (bool) {
        if (number < 2) return false;
        for (uint256 i = 2; i <= number / i; i++) {
            if (number % i == 0) return false;
        }
        return true;
    }
